diff --git a/hw/virtio/morpheus-seed.c b/hw/virtio/morpheus-seed.c
new file mode 100644
index 0000000000000000000000000000000000000000..e58149c3620627a9f8d2747f9f50cdeaa6dfa904
--- /dev/null
+++ b/hw/virtio/morpheus-seed.c
@@ -0,0 +1,343 @@
+/*
+ * Generic LibAFL seed consumer for the native QEMU virtio path.
+ *
+ * A seed can override a device MMIO read and can request one generic
+ * device-to-guest completion on a guest-programmed virtqueue.  The queue
+ * descriptor walk, DMA address space, used ring, and interrupt notification
+ * are all handled by QEMU's normal virtio implementation.
+ */
+
+#include "qemu/osdep.h"
+#include "standard-headers/linux/virtio_mmio.h"
+#include "system/dma.h"
+
+#include "hw/virtio/morpheus-seed.h"
+#include "trace.h"
+
+#define MORPHEUS_SEED_ENV "MORPHEUS_QEMU_INPUT_PATH"
+#define MORPHEUS_SEED_MAX_BYTES (1U << 20)
+#define MORPHEUS_SEED_RECORD_SIZE 40U
+#define MORPHEUS_SEED_GROUP_HEADER_SIZE 4U
+#define MORPHEUS_SEED_FAMILY_HYPER 2U
+
+#define MORPHEUS_SEED_OP_MMIO_READ 1U
+#define MORPHEUS_SEED_OP_QUEUE_DMA_WRITE 12U
+#define MORPHEUS_SEED_MMIO_OVERRIDE 1U
+
+#define MORPHEUS_DMA_OP_MAP 4U
+#define MORPHEUS_DMA_DIR_FROM_DEVICE 2U
+#define MORPHEUS_DMA_DIR_BIDIRECTIONAL 3U
+#define MORPHEUS_DMA_MAX_LENGTH (1U << 20)
+
+typedef struct MorpheusSeedAction {
+    uint8_t family;
+    uint8_t opcode;
+    uint16_t flags;
+    uint64_t arg0;
+    uint64_t arg1;
+    uint64_t arg2;
+    uint64_t arg3;
+    bool consumed;
+} MorpheusSeedAction;
+
+typedef struct MorpheusSeedState {
+    bool initialized;
+    bool enabled;
+    uint8_t *data;
+    gsize length;
+    uint64_t byte_cursor;
+    GArray *actions;
+} MorpheusSeedState;
+
+static MorpheusSeedState morpheus_seed;
+
+static uint16_t seed_load_u16(const uint8_t *data)
+{
+    return (uint16_t)data[0] | ((uint16_t)data[1] << 8);
+}
+
+static uint32_t seed_load_u32(const uint8_t *data)
+{
+    return (uint32_t)data[0] | ((uint32_t)data[1] << 8) |
+           ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+}
+
+static uint64_t seed_load_u64(const uint8_t *data)
+{
+    return (uint64_t)seed_load_u32(data) |
+           ((uint64_t)seed_load_u32(data + 4) << 32);
+}
+
+static void seed_parse_actions(void)
+{
+    size_t cursor = 0;
+
+    while (cursor < morpheus_seed.length) {
+        uint32_t count;
+
+        if (morpheus_seed.length - cursor < MORPHEUS_SEED_GROUP_HEADER_SIZE) {
+            morpheus_seed.enabled = false;
+            return;
+        }
+        count = seed_load_u32(morpheus_seed.data + cursor);
+        cursor += MORPHEUS_SEED_GROUP_HEADER_SIZE;
+        if (count == 0 || count > (morpheus_seed.length - cursor) /
+                              MORPHEUS_SEED_RECORD_SIZE) {
+            morpheus_seed.enabled = false;
+            return;
+        }
+        for (uint32_t index = 0; index < count; index++) {
+            const uint8_t *record = morpheus_seed.data + cursor;
+            MorpheusSeedAction action = {
+                .family = record[0],
+                .opcode = record[1],
+                .flags = seed_load_u16(record + 2),
+                .arg0 = seed_load_u64(record + 8),
+                .arg1 = seed_load_u64(record + 16),
+                .arg2 = seed_load_u64(record + 24),
+                .arg3 = seed_load_u64(record + 32),
+            };
+
+            if (action.family == MORPHEUS_SEED_FAMILY_HYPER) {
+                g_array_append_val(morpheus_seed.actions, action);
+            }
+            cursor += MORPHEUS_SEED_RECORD_SIZE;
+        }
+    }
+}
+
+static void seed_init(void)
+{
+    const char *path;
+    gchar *data = NULL;
+    gsize length = 0;
+
+    if (morpheus_seed.initialized) {
+        return;
+    }
+    morpheus_seed.initialized = true;
+    morpheus_seed.actions = g_array_new(false, false,
+                                        sizeof(MorpheusSeedAction));
+    path = g_getenv(MORPHEUS_SEED_ENV);
+    if (!path || !*path ||
+        !g_file_get_contents(path, &data, &length, NULL) ||
+        length == 0 || length > MORPHEUS_SEED_MAX_BYTES) {
+        g_free(data);
+        return;
+    }
+    morpheus_seed.data = (uint8_t *)data;
+    morpheus_seed.length = length;
+    morpheus_seed.enabled = true;
+    seed_parse_actions();
+}
+
+static uint64_t seed_next_byte(void)
+{
+    uint64_t value = morpheus_seed.data[
+        morpheus_seed.byte_cursor % morpheus_seed.length];
+
+    morpheus_seed.byte_cursor++;
+    return value;
+}
+
+static uint64_t seed_mask_for_size(unsigned size)
+{
+    if (size >= sizeof(uint64_t)) {
+        return UINT64_MAX;
+    }
+    return (UINT64_C(1) << (size * 8)) - 1;
+}
+
+static const MorpheusSeedAction *seed_find_mmio_override(uint64_t offset,
+                                                          unsigned size)
+{
+    if (!morpheus_seed.actions) {
+        return NULL;
+    }
+    for (guint index = 0; index < morpheus_seed.actions->len; index++) {
+        const MorpheusSeedAction *action =
+            &g_array_index(morpheus_seed.actions, MorpheusSeedAction, index);
+
+        if (action->opcode == MORPHEUS_SEED_OP_MMIO_READ &&
+            (action->flags & MORPHEUS_SEED_MMIO_OVERRIDE) &&
+            action->arg1 == size && action->arg0 == offset) {
+            return action;
+        }
+    }
+    return NULL;
+}
+
+uint64_t morpheus_virtio_seed_read_mmio(VirtIODevice *vdev,
+                                        uint64_t offset,
+                                        uint64_t value,
+                                        unsigned size)
+{
+    const MorpheusSeedAction *override;
+    uint64_t base = value;
+
+    seed_init();
+    if (!morpheus_seed.enabled || !vdev) {
+        return value;
+    }
+    override = seed_find_mmio_override(offset, size);
+    if (!override) {
+        return value;
+    }
+    value = override->arg2 & seed_mask_for_size(size);
+    trace_virtio_mmio_seed_read(offset, base, value, size,
+                                morpheus_seed.byte_cursor);
+    return value;
+}
+
+uint64_t morpheus_virtio_seed_read_features(VirtIODevice *vdev,
+                                            uint64_t value,
+                                            unsigned select)
+{
+    const MorpheusSeedAction *override;
+    const uint64_t offset = VIRTIO_MMIO_DEVICE_FEATURES +
+                            select * sizeof(uint32_t);
+    uint64_t base = value;
+
+    seed_init();
+    if (!morpheus_seed.enabled || !vdev) {
+        return value;
+    }
+    override = seed_find_mmio_override(offset, sizeof(uint32_t));
+    if (!override) {
+        return value;
+    }
+
+    value = override->arg2 & UINT32_MAX;
+    if (select < VIRTIO_FEATURES_NU32S) {
+        unsigned word = select / 2;
+        unsigned shift = (select % 2) * 32;
+
+        vdev->host_features_ex[word] |= value << shift;
+    }
+    trace_virtio_mmio_seed_read(offset, base, value, sizeof(uint32_t),
+                                morpheus_seed.byte_cursor);
+    return value;
+}
+
+uint64_t morpheus_virtio_seed_read_config(VirtIODevice *vdev,
+                                          uint64_t offset,
+                                          uint64_t value,
+                                          unsigned size)
+{
+    return morpheus_virtio_seed_read_mmio(
+        vdev, VIRTIO_MMIO_CONFIG + offset, value, size);
+}
+
+static MorpheusSeedAction *seed_find_queue_dma(uint16_t queue)
+{
+    if (!morpheus_seed.actions) {
+        return NULL;
+    }
+    for (guint index = 0; index < morpheus_seed.actions->len; index++) {
+        MorpheusSeedAction *action =
+            &g_array_index(morpheus_seed.actions, MorpheusSeedAction, index);
+        uint8_t operation = action->arg3 & 0xff;
+        uint8_t direction = (action->arg3 >> 8) & 0xff;
+
+        if (action->opcode != MORPHEUS_SEED_OP_QUEUE_DMA_WRITE ||
+            action->consumed || action->arg0 != queue ||
+            action->arg1 == 0 || action->arg1 > MORPHEUS_DMA_MAX_LENGTH ||
+            action->arg2 > UINT32_MAX || operation != MORPHEUS_DMA_OP_MAP ||
+            (direction != MORPHEUS_DMA_DIR_FROM_DEVICE &&
+             direction != MORPHEUS_DMA_DIR_BIDIRECTIONAL)) {
+            continue;
+        }
+        return action;
+    }
+    return NULL;
+}
+
+static uint32_t seed_dma_event(const MorpheusSeedAction *action)
+{
+    uint8_t operation = action->arg3 & 0xff;
+    uint8_t direction = (action->arg3 >> 8) & 0xff;
+    uint8_t path = (action->arg3 >> 16) & 0xff;
+    uint16_t sequence = (action->arg3 >> 24) & 0xffff;
+
+    return (uint32_t)operation | ((uint32_t)direction << 8) |
+           ((uint32_t)path << 10) | ((uint32_t)sequence << 16);
+}
+
+bool morpheus_virtio_seed_queue_dma_complete(VirtIODevice *vdev,
+                                             uint16_t queue)
+{
+    MorpheusSeedAction *action;
+    VirtQueue *vq;
+    VirtQueueElement *elem;
+    uint8_t *payload;
+    uint32_t payload_len;
+    uint32_t used_len;
+    uint32_t event;
+    size_t written = 0;
+    MemTxResult status = MEMTX_OK;
+
+    seed_init();
+    if (!morpheus_seed.enabled || !vdev ||
+        !(vdev->status & VIRTIO_CONFIG_S_DRIVER_OK) ||
+        queue >= VIRTIO_QUEUE_MAX || !virtio_queue_get_num(vdev, queue)) {
+        return false;
+    }
+
+    action = seed_find_queue_dma(queue);
+    if (!action) {
+        return false;
+    }
+    payload_len = action->arg1;
+    used_len = action->arg2;
+    event = seed_dma_event(action);
+    vq = virtio_get_queue(vdev, queue);
+
+    RCU_READ_LOCK_GUARD();
+    elem = virtqueue_pop(vq, sizeof(VirtQueueElement));
+    if (!elem) {
+        return false;
+    }
+
+    payload = g_malloc(payload_len);
+    for (uint32_t index = 0; index < payload_len; index++) {
+        payload[index] = seed_next_byte();
+    }
+
+    for (unsigned index = 0;
+         index < elem->in_num && written < payload_len; index++) {
+        size_t chunk = MIN(payload_len - written, elem->in_sg[index].iov_len);
+
+        status = dma_memory_write(vdev->dma_as, elem->in_addr[index],
+                                   payload + written, chunk,
+                                   MEMTXATTRS_UNSPECIFIED);
+        trace_virtio_mmio_seed_dma(elem->in_addr[index], chunk, event,
+                                   event & 0xff, (event >> 8) & 0x3,
+                                   morpheus_seed.byte_cursor, (int)status);
+        if (status != MEMTX_OK) {
+            break;
+        }
+        written += chunk;
+    }
+
+    if (status != MEMTX_OK || written != payload_len) {
+        trace_virtio_mmio_seed_dma(written, payload_len, event,
+                                   event & 0xff, (event >> 8) & 0x3,
+                                   morpheus_seed.byte_cursor, -1);
+        virtqueue_unpop(vq, elem, written);
+        g_free(payload);
+        g_free(elem);
+        return false;
+    }
+
+    virtqueue_fill(vq, elem, used_len, 0);
+    virtqueue_flush(vq, 1);
+    virtio_notify(vdev, vq);
+    trace_virtio_mmio_seed_dma(virtio_queue_get_used_addr(vdev, queue),
+                               used_len, event, event & 0xff,
+                               (event >> 8) & 0x3,
+                               morpheus_seed.byte_cursor, 0);
+    action->consumed = true;
+    g_free(payload);
+    g_free(elem);
+    return true;
+}
