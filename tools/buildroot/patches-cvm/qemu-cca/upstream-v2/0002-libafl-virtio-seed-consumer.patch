diff --git a/include/hw/virtio/morpheus-seed.h b/include/hw/virtio/morpheus-seed.h
new file mode 100644
index 0000000000000000000000000000000000000000..a85003436c68b8943d1a8c8a3b9eceea9ffd1700
--- /dev/null
+++ b/include/hw/virtio/morpheus-seed.h
@@ -0,0 +1,32 @@
+/*
+ * Low-level seed hooks shared by the virtio-mmio transport and the generic
+ * virtqueue completion path.  These hooks do not select a vulnerability or
+ * a device profile.
+ */
+
+#ifndef HW_VIRTIO_MORPHEUS_SEED_H
+#define HW_VIRTIO_MORPHEUS_SEED_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "hw/virtio/virtio.h"
+
+uint64_t morpheus_virtio_seed_read_mmio(VirtIODevice *vdev,
+                                        uint64_t offset,
+                                        uint64_t value,
+                                        unsigned size);
+
+uint64_t morpheus_virtio_seed_read_features(VirtIODevice *vdev,
+                                            uint64_t value,
+                                            unsigned select);
+
+uint64_t morpheus_virtio_seed_read_config(VirtIODevice *vdev,
+                                          uint64_t offset,
+                                          uint64_t value,
+                                          unsigned size);
+
+bool morpheus_virtio_seed_queue_dma_complete(VirtIODevice *vdev,
+                                             uint16_t queue);
+
+#endif
