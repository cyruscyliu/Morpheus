/*
 * VIA-inspired emulated device-interface model.
 *
 * Paper, Sec. 4 (Device Simulation): “The emulation mode allows VIA to
 * target higher layers ... emulated devices process data sent from the
 * driver to the device and automatically trigger interrupts depending on
 * the device's internal state.”
 *
 * This keeps the passthrough interface traces unchanged and redirects their
 * fill/ignore effects to externally supplied emulated-device hooks.
 */
extern observe_map_sync;
extern observe_dma_event;
extern unmap_passthrough_dma_buffers;
extern initialize_driver;
extern observe_interrupt_injection;
extern unload_driver;
extern return_input_stream_value;
extern emulated_mmio_read;
extern emulated_mmio_write;
extern emulated_pio_read;
extern emulated_pio_write;
extern emulated_dma_to_device;
extern emulated_dma_from_device;

machine via_emulation_mmio_dma {
    initial driver_uninitialized
    scratch {
        mmio_value;
        pio_value;
        write_value;
        irq_status;
        mmio_base;
        dma_addr;
        dma_len;
        interrupt_marker;
    }
    state driver_uninitialized
    state driver_initialized
    state interaction_active
    final state stopped

    /* Paper, Sec. 4: the harness issues system calls to “(i) initialize the
     * driver, (ii) trigger interactions ... and (iii) un-initialize the
     * driver”. */
    entry trace initialize_driver {
        sequence {
            extern initialize_driver;
        }
    }
    /* Paper, Sec. 4 (Intercepting IO): “MMIO and PIO regions are accessed via
     * a defined kernel interface.” */
    entry trace intercept_mmio_read {
        sequence {
            mmio_value = read32(unknown);
            extern emulated_mmio_read(mmio_value);
        }
    }
    entry trace intercept_mmio_write {
        sequence {
            write32(write_value, unknown);
            extern emulated_mmio_write(write_value);
        }
    }
    entry trace intercept_pio_read {
        sequence {
            pio_value = read32(unknown);
            extern emulated_pio_read(pio_value);
        }
    }
    entry trace intercept_pio_write {
        sequence {
            write32(write_value, unknown);
            extern emulated_pio_write(write_value);
        }
    }
    /* Paper, Sec. 4 (Intercepting IO): “Streaming DMA is synced once before
     * and after device interaction.” */
    entry trace intercept_driver_to_device_dma {
        sequence {
            dma_addr = 0x4000;
            dma_len = 0x80;
            extern observe_map_sync(1, dma_addr, dma_len);
            dma_event(op=map, dir=to_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            extern emulated_dma_to_device(dma_addr, dma_len);
        }
    }
    entry trace intercept_device_to_driver_dma {
        sequence {
            dma_addr = 0x8000;
            dma_len = 0x800;
            extern observe_map_sync(1, dma_addr, dma_len);
            dma_event(op=map, dir=from_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            extern observe_map_sync(2, dma_addr, dma_len);
            dma_event(op=sync_for_cpu, dir=from_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            extern emulated_dma_from_device(dma_addr, dma_len);
        }
    }

    /* Paper, Sec. 4 (DMA): coherent DMA is accessed continuously without
     * explicit CPU synchronization; allocation is the external signal. */
    entry trace intercept_coherent_dma_alloc {
        sequence {
            dma_addr = 0xa000;
            dma_len = 0x800;
            extern observe_dma_event(1, dma_addr, dma_len);
            dma_event(op=alloc, dir=from_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            extern emulated_dma_from_device(dma_addr, dma_len);
        }
    }
    entry trace intercept_coherent_dma_alloc_tx {
        sequence {
            dma_addr = 0xb000;
            dma_len = 0x800;
            extern observe_dma_event(1, dma_addr, dma_len);
            dma_event(op=alloc, dir=to_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            extern emulated_dma_to_device(dma_addr, dma_len);
        }
    }
    entry trace external_dma_unmapped {
        sequence {
            dma_addr = 0x8000;
            dma_len = 0x800;
            dma_event(op=unmap, dir=from_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            extern observe_map_sync(3, dma_addr, dma_len);
            extern unmap_passthrough_dma_buffers(dma_addr, dma_len);
        }
    }
    /* Paper, Sec. 4 (Targeted Interrupt Injection): the harness injects
     * interrupts to trigger driver/device interaction. */
    entry trace external_interrupt_injected {
        sequence {
            interrupt_marker = 1;
            extern observe_interrupt_injection(interrupt_marker);
            interrupt_event(vector=interrupt_marker);
            call inject_interrupt(interrupt_marker);
        }
    }
    /* Emulation changes the value handling delegated to the device model;
     * the interrupt-handler interface remains the passthrough baseline. */
    entry trace handle_interrupt {
        sequence {
            mmio_base = 0x1000;
            irq_status = read32(mmio_base + 0x60);
            extern emulated_mmio_read(irq_status);
            write32(irq_status, mmio_base + 0x64);
            extern emulated_mmio_write(irq_status);
        }
    }
    /* Driver teardown is a harness lifecycle operation. */
    entry trace external_driver_unloaded {
        sequence {
            extern unload_driver;
        }
    }

    transition driver_uninitialized -> driver_initialized on initialize_driver
    transition driver_initialized -> interaction_active on intercept_mmio_read
    transition driver_initialized -> interaction_active on intercept_mmio_write
    transition driver_initialized -> interaction_active on intercept_pio_read
    transition driver_initialized -> interaction_active on intercept_pio_write
    transition driver_initialized -> interaction_active on intercept_driver_to_device_dma
    transition driver_initialized -> interaction_active on intercept_device_to_driver_dma
    transition driver_initialized -> interaction_active on intercept_coherent_dma_alloc
    transition driver_initialized -> interaction_active on intercept_coherent_dma_alloc_tx
    transition interaction_active -> interaction_active on intercept_mmio_read
    transition interaction_active -> interaction_active on intercept_mmio_write
    transition interaction_active -> interaction_active on intercept_pio_read
    transition interaction_active -> interaction_active on intercept_pio_write
    transition interaction_active -> interaction_active on intercept_driver_to_device_dma
    transition interaction_active -> interaction_active on intercept_device_to_driver_dma
    transition interaction_active -> interaction_active on intercept_coherent_dma_alloc
    transition interaction_active -> interaction_active on intercept_coherent_dma_alloc_tx
    transition interaction_active -> interaction_active on handle_interrupt
    transition driver_initialized -> stopped on external_driver_unloaded
    transition interaction_active -> stopped on external_driver_unloaded
}
