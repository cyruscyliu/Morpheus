diff --git a/hw/virtio/morpheus-seed.c b/hw/virtio/morpheus-seed.c
new file mode 100644
index 0000000000..babbd50e95
--- /dev/null
+++ b/hw/virtio/morpheus-seed.c
@@ -0,0 +1,433 @@
+/*
+ * Generic LibAFL seed consumer for the native QEMU virtio path.
+ *
+ * This file deliberately knows only the action wire format and generic
+ * virtio transport operations.  It has no vulnerability or profile selector.
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/virtio/morpheus-seed.h"
+#include "trace.h"
+
+#define MORPHEUS_SEED_ENV "MORPHEUS_QEMU_INPUT_PATH"
+#define MORPHEUS_SEED_MAX_BYTES (1U << 20)
+#define MORPHEUS_SEED_RECORD_SIZE 40U
+#define MORPHEUS_SEED_GROUP_HEADER_SIZE 4U
+#define MORPHEUS_SEED_FAMILY_HYPER 2U
+
+#define MORPHEUS_SEED_OP_MMIO_READ 1U
+#define MORPHEUS_SEED_OP_VIRTIO_NET_RX 8U
+#define MORPHEUS_SEED_OP_VIRTIO_FEATURES 9U
+#define MORPHEUS_SEED_OP_VIRTIO_CONFIG 10U
+
+#define MORPHEUS_SEED_MMIO_OVERRIDE 1U
+#define MORPHEUS_SEED_CONFIG_BASE 0x100U
+
+#define MORPHEUS_DMA_EVENT_OFFSET 0x0c0U
+#define MORPHEUS_DMA_ADDR_LO_OFFSET 0x0c4U
+#define MORPHEUS_DMA_ADDR_HI_OFFSET 0x0c8U
+#define MORPHEUS_DMA_LENGTH_OFFSET 0x0ccU
+#define MORPHEUS_DMA_EVENT_OP_MASK 0xffU
+#define MORPHEUS_DMA_EVENT_DIR_SHIFT 8U
+#define MORPHEUS_DMA_EVENT_DIR_MASK 0x300U
+#define MORPHEUS_DMA_OP_MAP 4U
+#define MORPHEUS_DMA_DIR_FROM_DEVICE 2U
+#define MORPHEUS_DMA_DIR_BIDIRECTIONAL 3U
+#define MORPHEUS_DMA_MAX_LENGTH (1U << 20)
+
+typedef struct MorpheusSeedAction {
+    uint8_t family;
+    uint8_t opcode;
+    uint16_t flags;
+    uint64_t arg0;
+    uint64_t arg1;
+    uint64_t arg2;
+    uint64_t arg3;
+    bool consumed;
+} MorpheusSeedAction;
+
+typedef struct MorpheusSeedState {
+    bool initialized;
+    bool enabled;
+    bool structured;
+    uint8_t *data;
+    gsize length;
+    uint64_t byte_cursor;
+    uint32_t dma_addr_lo;
+    uint32_t dma_addr_hi;
+    uint32_t dma_length;
+    GArray *actions;
+} MorpheusSeedState;
+
+static MorpheusSeedState morpheus_seed;
+
+static uint16_t seed_load_u16(const uint8_t *data)
+{
+    return (uint16_t)data[0] | ((uint16_t)data[1] << 8);
+}
+
+static uint32_t seed_load_u32(const uint8_t *data)
+{
+    return (uint32_t)data[0] | ((uint32_t)data[1] << 8) |
+           ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+}
+
+static uint64_t seed_load_u64(const uint8_t *data)
+{
+    return (uint64_t)seed_load_u32(data) |
+           ((uint64_t)seed_load_u32(data + 4) << 32);
+}
+
+static void seed_parse_actions(void)
+{
+    size_t cursor = 0;
+
+    morpheus_seed.structured = true;
+    while (cursor < morpheus_seed.length) {
+        uint32_t count;
+
+        if (morpheus_seed.length - cursor < MORPHEUS_SEED_GROUP_HEADER_SIZE) {
+            morpheus_seed.structured = false;
+            return;
+        }
+        count = seed_load_u32(morpheus_seed.data + cursor);
+        cursor += MORPHEUS_SEED_GROUP_HEADER_SIZE;
+        if (count == 0 || count > (morpheus_seed.length - cursor) /
+                              MORPHEUS_SEED_RECORD_SIZE) {
+            morpheus_seed.structured = false;
+            return;
+        }
+        for (uint32_t index = 0; index < count; index++) {
+            const uint8_t *record = morpheus_seed.data + cursor;
+            MorpheusSeedAction action = {
+                .family = record[0],
+                .opcode = record[1],
+                .flags = seed_load_u16(record + 2),
+                .arg0 = seed_load_u64(record + 8),
+                .arg1 = seed_load_u64(record + 16),
+                .arg2 = seed_load_u64(record + 24),
+                .arg3 = seed_load_u64(record + 32),
+            };
+            if (action.family == MORPHEUS_SEED_FAMILY_HYPER) {
+                g_array_append_val(morpheus_seed.actions, action);
+            }
+            cursor += MORPHEUS_SEED_RECORD_SIZE;
+        }
+    }
+}
+
+static void seed_init(void)
+{
+    const char *path;
+    gchar *data = NULL;
+    gsize length = 0;
+
+    if (morpheus_seed.initialized) {
+        return;
+    }
+    morpheus_seed.initialized = true;
+    morpheus_seed.actions = g_array_new(false, false,
+                                        sizeof(MorpheusSeedAction));
+    path = g_getenv(MORPHEUS_SEED_ENV);
+    if (!path || !*path ||
+        !g_file_get_contents(path, &data, &length, NULL) ||
+        length == 0 || length > MORPHEUS_SEED_MAX_BYTES) {
+        g_free(data);
+        return;
+    }
+    morpheus_seed.data = (uint8_t *)data;
+    morpheus_seed.length = length;
+    morpheus_seed.enabled = true;
+    seed_parse_actions();
+}
+
+static bool seed_has_device_action(void)
+{
+    for (guint index = 0; index < morpheus_seed.actions->len; index++) {
+        const MorpheusSeedAction *action =
+            &g_array_index(morpheus_seed.actions, MorpheusSeedAction, index);
+        if (action->opcode == MORPHEUS_SEED_OP_VIRTIO_NET_RX ||
+            action->opcode == MORPHEUS_SEED_OP_VIRTIO_FEATURES ||
+            action->opcode == MORPHEUS_SEED_OP_VIRTIO_CONFIG ||
+            (action->opcode == MORPHEUS_SEED_OP_MMIO_READ &&
+             (action->flags & MORPHEUS_SEED_MMIO_OVERRIDE))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static uint64_t seed_next_bytes(unsigned size)
+{
+    uint64_t value = 0;
+
+    size = MIN(size, sizeof(value));
+    for (unsigned index = 0; index < size; index++) {
+        value |= (uint64_t)morpheus_seed.data[
+            morpheus_seed.byte_cursor % morpheus_seed.length] << (index * 8);
+        morpheus_seed.byte_cursor++;
+    }
+    return value;
+}
+
+static uint64_t seed_mask_for_size(unsigned size)
+{
+    if (size >= sizeof(uint64_t)) {
+        return UINT64_MAX;
+    }
+    return (UINT64_C(1) << (size * 8)) - 1;
+}
+
+static const MorpheusSeedAction *seed_find_action(uint8_t opcode)
+{
+    if (!morpheus_seed.actions) {
+        return NULL;
+    }
+    for (guint index = 0; index < morpheus_seed.actions->len; index++) {
+        const MorpheusSeedAction *action =
+            &g_array_index(morpheus_seed.actions, MorpheusSeedAction, index);
+        if (action->opcode == opcode) {
+            return action;
+        }
+    }
+    return NULL;
+}
+
+static bool seed_range_contains(uint64_t offset, unsigned size,
+                                uint64_t action_offset, uint64_t action_width)
+{
+    return action_width >= size && action_width <= sizeof(uint64_t) &&
+           action_offset <= offset && offset - action_offset <= action_width - size;
+}
+
+static bool seed_match_mmio_override(const MorpheusSeedAction *action,
+                                     uint64_t offset, unsigned size)
+{
+    if (!action || action->opcode != MORPHEUS_SEED_OP_MMIO_READ ||
+        !(action->flags & MORPHEUS_SEED_MMIO_OVERRIDE) ||
+        action->arg1 != size) {
+        return false;
+    }
+    return action->arg0 == offset ||
+           action->arg0 == MORPHEUS_SEED_CONFIG_BASE + offset;
+}
+
+static const MorpheusSeedAction *seed_find_mmio_override(uint64_t offset,
+                                                          unsigned size)
+{
+    if (!morpheus_seed.actions) {
+        return NULL;
+    }
+    for (guint index = 0; index < morpheus_seed.actions->len; index++) {
+        const MorpheusSeedAction *action =
+            &g_array_index(morpheus_seed.actions, MorpheusSeedAction, index);
+        if (seed_match_mmio_override(action, offset, size)) {
+            return action;
+        }
+    }
+    return NULL;
+}
+
+static uint64_t seed_read_override(uint64_t value, unsigned size)
+{
+    return value & seed_mask_for_size(size);
+}
+
+uint64_t morpheus_virtio_seed_read_mmio(VirtIODevice *vdev,
+                                        uint64_t offset,
+                                        uint64_t value,
+                                        unsigned size,
+                                        bool keep_nonzero)
+{
+    uint64_t base;
+    const MorpheusSeedAction *override;
+
+    seed_init();
+    if (!morpheus_seed.enabled || !vdev) {
+        return value;
+    }
+    base = value;
+    override = seed_find_mmio_override(offset, size);
+    if (override) {
+        value = seed_read_override(override->arg2, size);
+        trace_virtio_mmio_seed_read(offset, base, value, size,
+                                    morpheus_seed.byte_cursor);
+        return value;
+    }
+    if (morpheus_seed.structured && seed_has_device_action()) {
+        return value;
+    }
+    value = (base ^ seed_next_bytes(size)) & seed_mask_for_size(size);
+    if (keep_nonzero && base != 0 && value == 0) {
+        value = base & seed_mask_for_size(size);
+    }
+    trace_virtio_mmio_seed_read(offset, base, value, size,
+                                morpheus_seed.byte_cursor);
+    return value;
+}
+
+uint64_t morpheus_virtio_seed_read_features(VirtIODevice *vdev,
+                                            uint64_t value,
+                                            unsigned select)
+{
+    const MorpheusSeedAction *action;
+    uint64_t base;
+    uint64_t features;
+
+    seed_init();
+    action = seed_find_action(MORPHEUS_SEED_OP_VIRTIO_FEATURES);
+    if (!morpheus_seed.enabled || !action) {
+        return morpheus_virtio_seed_read_mmio(
+            vdev, 0x10 + select * sizeof(uint32_t), value,
+            sizeof(uint32_t), true);
+    }
+    base = value;
+    features = action->arg0;
+    vdev->host_features_ex[0] |= features;
+    value |= select < 2 ? (features >> (select * 32)) & UINT32_MAX : 0;
+    trace_virtio_mmio_seed_read(0x10 + select * sizeof(uint32_t), base, value,
+                                sizeof(uint32_t),
+                                morpheus_seed.byte_cursor);
+    return value;
+}
+
+uint64_t morpheus_virtio_seed_preserve_read(VirtIODevice *vdev,
+                                            uint64_t offset,
+                                            uint64_t value,
+                                            unsigned size)
+{
+    seed_init();
+    if (!morpheus_seed.enabled || !vdev) {
+        return value;
+    }
+    if (!morpheus_seed.structured || !seed_has_device_action()) {
+        (void)seed_next_bytes(size);
+    }
+    trace_virtio_mmio_seed_read(offset, value, value, size,
+                                morpheus_seed.byte_cursor);
+    return value;
+}
+
+uint64_t morpheus_virtio_seed_read_config(VirtIODevice *vdev,
+                                          uint64_t offset,
+                                          uint64_t value,
+                                          unsigned size)
+{
+    seed_init();
+    for (guint index = 0; index < morpheus_seed.actions->len; index++) {
+        const MorpheusSeedAction *action =
+            &g_array_index(morpheus_seed.actions, MorpheusSeedAction, index);
+        if (action->opcode == MORPHEUS_SEED_OP_MMIO_READ &&
+            (action->flags & MORPHEUS_SEED_MMIO_OVERRIDE)) {
+            uint64_t action_offset = action->arg0 >= MORPHEUS_SEED_CONFIG_BASE
+                                   ? action->arg0 - MORPHEUS_SEED_CONFIG_BASE
+                                   : action->arg0;
+            if (seed_range_contains(offset, size, action_offset, action->arg1)) {
+                return seed_read_override(action->arg2 >>
+                                          ((offset - action_offset) * 8),
+                                          size);
+            }
+        }
+        if (action->opcode == MORPHEUS_SEED_OP_VIRTIO_CONFIG) {
+            if (seed_range_contains(offset, size, action->arg0, action->arg1)) {
+                return seed_read_override(action->arg2 >>
+                                          ((offset - action->arg0) * 8),
+                                          size);
+            }
+        }
+    }
+    return morpheus_virtio_seed_read_mmio(
+        vdev, MORPHEUS_SEED_CONFIG_BASE + offset, value, size, false);
+}
+
+bool morpheus_virtio_seed_dma_write(VirtIODevice *vdev,
+                                    uint64_t offset,
+                                    uint64_t value,
+                                    unsigned size)
+{
+    uint32_t event;
+    uint8_t opcode;
+    uint8_t direction;
+    uint64_t address;
+    uint32_t length;
+    uint8_t *buffer;
+    MemTxResult status;
+
+    seed_init();
+    if (!morpheus_seed.enabled || size != sizeof(uint32_t)) {
+        return false;
+    }
+    if (offset == MORPHEUS_DMA_ADDR_LO_OFFSET) {
+        morpheus_seed.dma_addr_lo = value;
+        return true;
+    }
+    if (offset == MORPHEUS_DMA_ADDR_HI_OFFSET) {
+        morpheus_seed.dma_addr_hi = value;
+        return true;
+    }
+    if (offset == MORPHEUS_DMA_LENGTH_OFFSET) {
+        morpheus_seed.dma_length = value;
+        return true;
+    }
+    if (offset != MORPHEUS_DMA_EVENT_OFFSET) {
+        return false;
+    }
+
+    event = value;
+    opcode = event & MORPHEUS_DMA_EVENT_OP_MASK;
+    direction = (event & MORPHEUS_DMA_EVENT_DIR_MASK) >>
+                MORPHEUS_DMA_EVENT_DIR_SHIFT;
+    address = ((uint64_t)morpheus_seed.dma_addr_hi << 32) |
+              morpheus_seed.dma_addr_lo;
+    length = morpheus_seed.dma_length;
+    if (opcode != MORPHEUS_DMA_OP_MAP ||
+        (direction != MORPHEUS_DMA_DIR_FROM_DEVICE &&
+         direction != MORPHEUS_DMA_DIR_BIDIRECTIONAL) ||
+        !address || !length || length > MORPHEUS_DMA_MAX_LENGTH ||
+        address > UINT64_MAX - ((uint64_t)length - 1) || !vdev->dma_as) {
+        trace_virtio_mmio_seed_dma(address, length, event, opcode, direction,
+                                   morpheus_seed.byte_cursor, -1);
+        return true;
+    }
+    buffer = g_try_malloc(length);
+    if (!buffer) {
+        trace_virtio_mmio_seed_dma(address, length, event, opcode, direction,
+                                   morpheus_seed.byte_cursor, -2);
+        return true;
+    }
+    for (uint32_t index = 0; index < length; index++) {
+        buffer[index] = (uint8_t)seed_next_bytes(1);
+    }
+    status = address_space_write(vdev->dma_as, address,
+                                 MEMTXATTRS_UNSPECIFIED, buffer, length);
+    g_free(buffer);
+    trace_virtio_mmio_seed_dma(address, length, event, opcode, direction,
+                               morpheus_seed.byte_cursor, (int)status);
+    return true;
+}
+
+bool morpheus_virtio_seed_take_rx(VirtIODevice *vdev,
+                                  uint16_t queue,
+                                  MorpheusVirtioSeedRx *rx)
+{
+    if (!vdev || !rx) {
+        return false;
+    }
+    seed_init();
+    for (guint index = 0; index < morpheus_seed.actions->len; index++) {
+        MorpheusSeedAction *action =
+            &g_array_index(morpheus_seed.actions, MorpheusSeedAction, index);
+        if (action->opcode != MORPHEUS_SEED_OP_VIRTIO_NET_RX ||
+            action->consumed || action->arg0 != queue ||
+            action->arg1 > UINT32_MAX || action->arg2 > UINT32_MAX) {
+            continue;
+        }
+        action->consumed = true;
+        rx->queue = queue;
+        rx->payload_len = action->arg1;
+        rx->used_len = action->arg2;
+        return true;
+    }
+    return false;
+}
