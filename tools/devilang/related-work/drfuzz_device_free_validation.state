/* DrFuzz device-adaptor model, using the VIA passthrough interface shape.
 * DrFuzz has no physical device or complete virtual-device implementation:
 * its adaptor exposes fake I/O regions and injects fuzzer data into driver.
 */
extern initialize_driver;
extern unload_driver;
extern return_input_stream_value;
extern observe_dma_event;
extern observe_interrupt_injection;
extern open_driver;
extern ioctl_driver;
extern read_driver;
extern write_driver;

machine drfuzz_device_free_validation {
    initial driver_uninitialized
    scratch {
        mmio_value;
        pio_value;
        write_value;
        dma_addr;
        dma_len;
        interrupt_marker;
    }
    state driver_uninitialized
    state driver_initialized
    state interaction_active
    final state stopped

    /* The adaptor injects fuzzer-produced values for intercepted reads. */
    entry trace intercept_mmio_read {
        sequence {
            mmio_value = read32(unknown);
            extern return_input_stream_value(mmio_value, 4);
        }
    }
    entry trace intercept_mmio_write {
        sequence {
            write32(write_value, unknown);
            call ignore_driver_mmio_write(write_value);
        }
    }
    entry trace intercept_pio_read {
        sequence {
            pio_value = read32(unknown);
            extern return_input_stream_value(pio_value, 4);
        }
    }
    entry trace intercept_pio_write {
        sequence {
            write32(write_value, unknown);
            call ignore_driver_pio_write(write_value);
        }
    }

    /* For a target using streaming DMA, the adaptor observes map; no payload
     * schema is inferred. */
    entry trace streaming_device_to_driver_dma {
        sequence {
            dma_addr = 0x8000;
            dma_len = 0x400;
            extern observe_dma_event(dma_addr, dma_len);
            dma_event(op=map, dir=from_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            call fill_mutated_dma_payload(dma_addr, dma_len);
        }
    }
    entry trace streaming_driver_to_device_dma {
        sequence {
            dma_addr = 0x9000;
            dma_len = 0x400;
            extern observe_dma_event(dma_addr, dma_len);
            dma_event(op=map, dir=to_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            call ignore_driver_to_device_dma(dma_addr, dma_len);
        }
    }

    /* For a target using coherent DMA, allocation has no explicit sync. */
    entry trace coherent_device_to_driver_dma {
        sequence {
            dma_addr = 0xa000;
            dma_len = 0x400;
            extern observe_dma_event(dma_addr, dma_len);
            dma_event(op=alloc, dir=from_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            call fill_mutated_dma_payload(dma_addr, dma_len);
        }
    }
    entry trace coherent_driver_to_device_dma {
        sequence {
            dma_addr = 0xb000;
            dma_len = 0x400;
            extern observe_dma_event(dma_addr, dma_len);
            dma_event(op=alloc, dir=to_device, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
            call ignore_driver_to_device_dma(dma_addr, dma_len);
        }
    }
    entry trace dma_unmapped {
        sequence {
            extern observe_dma_event(dma_addr, dma_len);
            dma_event(op=unmap, dir=bidirectional, path=dma_api, addr=dma_addr, len=dma_len, data_kind=any);
        }
    }

    /* The adaptor injects interrupts; there is no device-side IRQ model. */
    entry trace external_interrupt_injected {
        sequence {
            interrupt_marker = 1;
            extern observe_interrupt_injection(interrupt_marker);
            interrupt_event(vector=interrupt_marker);
            call inject_interrupt(interrupt_marker);
        }
    }
    entry trace handle_interrupt {
        sequence {
            mmio_value = read32(unknown);
            extern return_input_stream_value(mmio_value, 4);
            write32(mmio_value, unknown);
            call ignore_driver_mmio_write(mmio_value);
        }
    }

    /* These are external control-plane operations, not virtual-device calls. */
    entry trace external_user_open {
        sequence {
            extern open_driver;
        }
    }
    entry trace external_user_ioctl {
        sequence {
            extern ioctl_driver;
        }
    }
    entry trace external_user_read {
        sequence {
            extern read_driver;
        }
    }
    entry trace external_user_write {
        sequence {
            extern write_driver;
        }
    }
    entry trace initialize_driver {
        sequence {
            extern initialize_driver;
        }
    }
    entry trace external_driver_unloaded {
        sequence {
            extern unload_driver;
        }
    }

    transition driver_uninitialized -> driver_initialized on initialize_driver
    transition driver_initialized -> interaction_active on intercept_mmio_read
    transition driver_initialized -> interaction_active on intercept_mmio_write
    transition driver_initialized -> interaction_active on intercept_pio_read
    transition driver_initialized -> interaction_active on intercept_pio_write
    transition driver_initialized -> interaction_active on streaming_device_to_driver_dma
    transition driver_initialized -> interaction_active on streaming_driver_to_device_dma
    transition driver_initialized -> interaction_active on coherent_device_to_driver_dma
    transition driver_initialized -> interaction_active on coherent_driver_to_device_dma
    transition driver_initialized -> interaction_active on external_user_open
    transition interaction_active -> interaction_active on intercept_mmio_read
    transition interaction_active -> interaction_active on intercept_mmio_write
    transition interaction_active -> interaction_active on intercept_pio_read
    transition interaction_active -> interaction_active on intercept_pio_write
    transition interaction_active -> interaction_active on streaming_device_to_driver_dma
    transition interaction_active -> interaction_active on streaming_driver_to_device_dma
    transition interaction_active -> interaction_active on coherent_device_to_driver_dma
    transition interaction_active -> interaction_active on coherent_driver_to_device_dma
    transition interaction_active -> interaction_active on dma_unmapped
    transition interaction_active -> interaction_active on external_interrupt_injected
    transition interaction_active -> interaction_active on handle_interrupt
    transition interaction_active -> interaction_active on external_user_ioctl
    transition interaction_active -> interaction_active on external_user_read
    transition interaction_active -> interaction_active on external_user_write
    transition driver_initialized -> stopped on external_driver_unloaded
    transition interaction_active -> stopped on external_driver_unloaded
}
