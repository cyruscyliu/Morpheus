diff --git a/libafl/syx-snapshot/syx-cow-cache.c b/libafl/syx-snapshot/syx-cow-cache.c
index f89fa48..0d6bf4d 100644
--- a/libafl/syx-snapshot/syx-cow-cache.c
+++ b/libafl/syx-snapshot/syx-cow-cache.c
@@ -169,6 +169,12 @@ static bool write_to_cache_layer(SyxCowCacheLayer* sccl, BlockBackend* blk,
                                  int64_t offset, int64_t bytes,
                                  QEMUIOVector* qiov)
 {
+    uint64_t new_chunks = 0;
+
+    if (!qiov) {
+        return false;
+    }
+
     if (qiov->size % sccl->chunk_size) {
         // todo: determine if it is worth developing an unaligned access
         // version.
@@ -192,8 +198,17 @@ static bool write_to_cache_layer(SyxCowCacheLayer* sccl, BlockBackend* blk,

     assert(cache_entry && cache_entry->data);

-    if (cache_entry->data->len + (qiov->size / sccl->chunk_size) >
-        sccl->max_nb_chunks) {
+    for (uint64_t blk_offset = offset, qiov_offset = 0;
+         qiov_offset < qiov->size;
+         blk_offset += sccl->chunk_size, qiov_offset += sccl->chunk_size) {
+        if (!g_hash_table_contains(cache_entry->positions,
+                                   GUINT_TO_POINTER(blk_offset))) {
+            new_chunks++;
+        }
+    }
+
+    if (cache_entry->data->len > sccl->max_nb_chunks ||
+        new_chunks > sccl->max_nb_chunks - cache_entry->data->len) {
         return false;
     }

@@ -209,6 +224,39 @@ static bool write_to_cache_layer(SyxCowCacheLayer* sccl, BlockBackend* blk,
     return true;
 }

+static bool write_zeroes_to_cache_layer(SyxCowCacheLayer* sccl,
+                                        BlockBackend* blk, int64_t offset,
+                                        int64_t bytes)
+{
+    const uint64_t chunk_size = sccl->chunk_size;
+    bool ok = true;
+
+    if (bytes < 0 || offset < 0 ||
+        ((uint64_t)offset % chunk_size) != 0 ||
+        ((uint64_t)bytes % chunk_size) != 0) {
+        return false;
+    }
+    if (bytes == 0) {
+        return true;
+    }
+
+    uint8_t* zero_chunk = g_malloc0(chunk_size);
+    QEMUIOVector zero_qiov;
+    qemu_iovec_init_buf(&zero_qiov, zero_chunk, chunk_size);
+
+    for (uint64_t written = 0; written < (uint64_t)bytes;
+         written += chunk_size) {
+        if (!write_to_cache_layer(sccl, blk, offset + written, chunk_size,
+                                  &zero_qiov)) {
+            ok = false;
+            break;
+        }
+    }
+
+    g_free(zero_chunk);
+    return ok;
+}
+
 void syx_cow_cache_read_entry(SyxCowCache* scc, BlockBackend* blk,
                               int64_t offset, int64_t bytes, QEMUIOVector* qiov,
                               size_t _qiov_offset, BdrvRequestFlags flags)
@@ -251,10 +299,16 @@ bool syx_cow_cache_write_entry(SyxCowCache* scc, BlockBackend* blk,
     // offset);

     layer = QTAILQ_FIRST(&scc->layers);
-    if (layer) {
-        assert(write_to_cache_layer(layer, blk, offset, bytes, qiov));
-        return true;
-    } else {
+    if (!layer) {
         return false;
     }
+
+    if (!qiov) {
+        if (!(flags & BDRV_REQ_ZERO_WRITE)) {
+            return false;
+        }
+        return write_zeroes_to_cache_layer(layer, blk, offset, bytes);
+    }
+
+    return write_to_cache_layer(layer, blk, offset, bytes, qiov);
 }
diff --git a/system/physmem.c b/system/physmem.c
