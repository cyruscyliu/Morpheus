+}
+
+#define HYPERARM_HP_DMA_EVENT_OFFSET          0x1c0
+#define HYPERARM_HP_DMA_ADDR_LO_OFFSET        0x1c4
+#define HYPERARM_HP_DMA_ADDR_HI_OFFSET        0x1c8
+#define HYPERARM_HP_DMA_LEN_OFFSET            0x1cc
+#define HYPERARM_HP_DMA_EVENT_OPCODE_SHIFT    0u
+#define HYPERARM_HP_DMA_EVENT_OPCODE_MASK     0x000000ffu
+#define HYPERARM_HP_DMA_EVENT_DIRECTION_SHIFT 8u
+#define HYPERARM_HP_DMA_EVENT_DIRECTION_MASK  0x00000300u
+#define HYPERARM_HP_DMA_EVENT_PATH_SHIFT      10u
+#define HYPERARM_HP_DMA_EVENT_PATH_MASK       0x00000c00u
+#define HYPERARM_HP_DMA_CAPTURE_MAX           256u
+
+static hwaddr virtio_mmio_transport_base(VirtIOMMIOProxy *proxy)
+{
+    MemoryRegionSection section = memory_region_find(&proxy->iomem, 0, 0x200);
+    hwaddr base;
+
+    if (!section.mr) {
+        return 0;
+    }
+
+    base = section.offset_within_address_space;
+    memory_region_unref(section.mr);
+    return base;
+}
+
+static uint8_t virtio_mmio_dma_event_opcode(uint32_t event)
+{
+    return (event & HYPERARM_HP_DMA_EVENT_OPCODE_MASK) >>
+           HYPERARM_HP_DMA_EVENT_OPCODE_SHIFT;
+}
+
+static uint8_t virtio_mmio_dma_event_direction(uint32_t event)
+{
+    return (event & HYPERARM_HP_DMA_EVENT_DIRECTION_MASK) >>
+           HYPERARM_HP_DMA_EVENT_DIRECTION_SHIFT;
+}
+
+static uint8_t virtio_mmio_dma_event_path(uint32_t event)
+{
+    return (event & HYPERARM_HP_DMA_EVENT_PATH_MASK) >>
+           HYPERARM_HP_DMA_EVENT_PATH_SHIFT;
+}
+
+static const char *virtio_mmio_dma_event_view(uint32_t op, uint32_t dir)
+{
+    switch (op) {
+    case 0x04:
+    case 0x08:
+        if (dir == 0x02 || dir == 0x03) {
+            return "complete";
+        }
+        return "submit";
+    case 0x06:
+    case 0x07:
+        if (dir == 0x02 || dir == 0x03) {
+            return "complete";
+        }
+        return "release";
+    case 0x09:
+    case 0x0a:
+    case 0x0b:
+    case 0x0c:
+        return "queue-state";
+    case 0x01:
+    case 0x02:
+    case 0x03:
+    case 0x05:
+    default:
+        return "live";
+    }
+}
+
+static char *virtio_mmio_hex_encode(const uint8_t *buf, size_t len)
+{
+    static const char hex[] = "0123456789abcdef";
+    char *out;
+    size_t i;
+
+    out = g_malloc(len * 2 + 1);
+    for (i = 0; i < len; ++i) {
+        out[i * 2] = hex[(buf[i] >> 4) & 0xf];
+        out[i * 2 + 1] = hex[buf[i] & 0xf];
+    }
+    out[len * 2] = '\0';
+    return out;
+}
+
+static void virtio_mmio_trace_write(VirtIOMMIOProxy *proxy,
+                                    hwaddr offset,
+                                    uint64_t value,
+                                    unsigned size)
+{
+    hwaddr base = virtio_mmio_transport_base(proxy);
+    uint64_t dma_addr =
+        ((uint64_t)proxy->hp_dma_addr_hi << 32) | proxy->hp_dma_addr_lo;
+    uint32_t dma_len = 0;
+    uint32_t dma_capture_len = 0;
+    uint32_t dma_dir = 0;
+    uint32_t dma_op = 0;
+    uint32_t dma_path = 0;
+    const char *dma_view = "live";
+    g_autofree uint8_t *dma_buf = NULL;
+    g_autofree char *dma_hex = NULL;
+    g_autofree char *dma_data = NULL;
+
+    dma_data = g_strdup("-");
+
+    if (offset == HYPERARM_HP_DMA_EVENT_OFFSET && size == 4) {
+        uint32_t event = (uint32_t)value;
+
+        dma_len = proxy->hp_dma_len;
+        dma_dir = virtio_mmio_dma_event_direction(event);
+        dma_op = virtio_mmio_dma_event_opcode(event);
+        dma_path = virtio_mmio_dma_event_path(event);
+        dma_view = virtio_mmio_dma_event_view(dma_op, dma_dir);
+        dma_data = g_strdup(dma_view);
+        if (dma_addr && dma_len) {
+            dma_capture_len = MIN(dma_len, HYPERARM_HP_DMA_CAPTURE_MAX);
+            dma_buf = g_malloc(dma_capture_len);
+            if (address_space_read(&address_space_memory, dma_addr,
+                                   MEMTXATTRS_UNSPECIFIED, dma_buf,
+                                   dma_capture_len) == MEMTX_OK) {
+                dma_hex = virtio_mmio_hex_encode(dma_buf, dma_capture_len);
+                dma_data = g_strdup_printf("%s:%s", dma_view, dma_hex);
+            } else {
+                dma_data = g_strdup_printf("%s:read-failed", dma_view);
+            }
+        }
+    }
+
+    trace_virtio_mmio_write_offset(base, offset, base + offset, value,
+                                   dma_addr, dma_len, dma_dir, dma_op,
+                                   dma_path, dma_data);
+}
+
+static uint64_t virtio_mmio_trace_read_result(VirtIOMMIOProxy *proxy,
+                                              hwaddr offset,
+                                              uint64_t value)
+{
+    hwaddr base = virtio_mmio_transport_base(proxy);
+
+    trace_virtio_mmio_read(base, offset, base + offset, value);
+    return value;
 }
 
