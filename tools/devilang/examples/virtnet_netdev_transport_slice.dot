digraph VirtnetTransportSlice {
    rankdir=LR;
    node [shape=box, style=filled, fillcolor=lightyellow];

    subgraph cluster_virtnet_netdev_roots {
        label="virtnet_netdev roots";
        style="rounded,filled";
        fillcolor="#eeffee";
        color=darkgreen;
        fontcolor=darkgreen;
        penwidth=2;
        "start_xmit";
        "virtnet_close";
        "virtnet_open";
        "virtnet_set_features";
        "virtnet_set_mac_address";
        "virtnet_set_rx_mode";
        "virtnet_tx_timeout";
        "virtnet_vlan_rx_add_vid";
        "virtnet_vlan_rx_kill_vid";
        "virtnet_xdp";
        "virtnet_xdp_xmit";
        "virtnet_xsk_wakeup";
    }

    subgraph cluster_virtio_mmio_config_ops_reachable {
        label="virtio_mmio_config_ops reachable";
        style="rounded,filled";
        fillcolor="#ffeaea";
        color=darkred;
        fontcolor=darkred;
        penwidth=2;
        "vm_bus_name";
        "vm_del_vqs";
        "vm_finalize_features";
        "vm_find_vqs";
        "vm_generation";
        "vm_get";
        "vm_get_features";
        "vm_get_shm_region";
        "vm_get_status";
        "vm_notify";
        "vm_notify_with_data";
        "vm_reset";
        "vm_set";
        "vm_set_status";
        "vm_synchronize_cbs";
    }

    subgraph cluster_queue_and_transport_targets {
        label="queue and transport targets";
        style="rounded,filled";
        fillcolor="#ddeeff";
        color=steelblue;
        fontcolor=steelblue;
        penwidth=2;
        "virtio_cwrite8";
        "virtqueue_add_inbuf";
        "virtqueue_add_inbuf_premapped";
        "virtqueue_add_outbuf";
        "virtqueue_add_outbuf_premapped";
        "virtqueue_add_sgs";
        "virtqueue_kick";
        "virtqueue_kick_prepare";
        "virtqueue_notify";
    }

    "__virtnet_rx_resume";
    "__virtnet_xdp_xmit_one";
    "add_recvbuf_big";
    "add_recvbuf_mergeable";
    "add_recvbuf_small";
    "try_fill_recv";
    "virtnet_add_outbuf";
    "virtnet_clear_guest_offloads";
    "virtnet_commit_rss_command";
    "virtnet_restore_guest_offloads";
    "virtnet_rq_bind_xsk_pool";
    "virtnet_rq_init_one_sg";
    "virtnet_rx_resume";
    "virtnet_rx_resume_all";
    "virtnet_send_command";
    "virtnet_send_command_reply";
    "virtnet_set_guest_offloads";
    "virtnet_set_queues";
    "virtnet_xdp_set";
    "virtnet_xsk_pool_disable";
    "virtnet_xsk_pool_enable";
    "virtnet_xsk_pool_setup";
    "virtqueue_add";
    "virtqueue_add_split";
    "xmit_skb";

    "__virtnet_rx_resume" -> "try_fill_recv";
    "__virtnet_xdp_xmit_one" -> "virtnet_add_outbuf";
    "add_recvbuf_big" -> "virtqueue_add_inbuf" [color=red, penwidth=2];
    "add_recvbuf_mergeable" -> "virtnet_rq_init_one_sg";
    "add_recvbuf_mergeable" -> "virtqueue_add_inbuf_premapped" [color=red, penwidth=2];
    "add_recvbuf_small" -> "virtnet_rq_init_one_sg";
    "add_recvbuf_small" -> "virtqueue_add_inbuf_premapped" [color=red, penwidth=2];
    "start_xmit" -> "virtqueue_kick_prepare" [color=red, penwidth=2];
    "start_xmit" -> "virtqueue_notify" [color=red, penwidth=2];
    "start_xmit" -> "xmit_skb" [color=darkgreen];
    "try_fill_recv" -> "add_recvbuf_big";
    "try_fill_recv" -> "add_recvbuf_mergeable";
    "try_fill_recv" -> "add_recvbuf_small";
    "try_fill_recv" -> "virtqueue_kick_prepare" [color=red, penwidth=2];
    "try_fill_recv" -> "virtqueue_notify" [color=red, penwidth=2];
    "virtio_cwrite8" -> "vm_set" [color=red, penwidth=2];
    "virtnet_add_outbuf" -> "virtqueue_add_outbuf" [color=red, penwidth=2];
    "virtnet_clear_guest_offloads" -> "virtnet_set_guest_offloads";
    "virtnet_commit_rss_command" -> "virtnet_send_command";
    "virtnet_open" -> "try_fill_recv" [color=darkgreen];
    "virtnet_restore_guest_offloads" -> "virtnet_set_guest_offloads";
    "virtnet_rq_bind_xsk_pool" -> "virtnet_rx_resume";
    "virtnet_rx_resume" -> "__virtnet_rx_resume";
    "virtnet_rx_resume_all" -> "__virtnet_rx_resume";
    "virtnet_send_command" -> "virtnet_send_command_reply";
    "virtnet_send_command_reply" -> "virtqueue_add_sgs" [color=red, penwidth=2];
    "virtnet_send_command_reply" -> "virtqueue_kick" [color=red, penwidth=2];
    "virtnet_set_features" -> "virtnet_commit_rss_command" [color=darkgreen];
    "virtnet_set_features" -> "virtnet_set_guest_offloads" [color=darkgreen];
    "virtnet_set_guest_offloads" -> "virtnet_send_command";
    "virtnet_set_mac_address" -> "virtio_cwrite8" [color=red, penwidth=2];
    "virtnet_set_mac_address" -> "virtnet_send_command" [color=darkgreen];
    "virtnet_set_queues" -> "virtnet_commit_rss_command";
    "virtnet_set_queues" -> "virtnet_send_command";
    "virtnet_vlan_rx_add_vid" -> "virtnet_send_command" [color=darkgreen];
    "virtnet_vlan_rx_kill_vid" -> "virtnet_send_command" [color=darkgreen];
    "virtnet_xdp" -> "virtnet_xdp_set" [color=darkgreen];
    "virtnet_xdp" -> "virtnet_xsk_pool_setup" [color=darkgreen];
    "virtnet_xdp_set" -> "virtnet_clear_guest_offloads";
    "virtnet_xdp_set" -> "virtnet_restore_guest_offloads";
    "virtnet_xdp_set" -> "virtnet_rx_resume_all";
    "virtnet_xdp_set" -> "virtnet_set_queues";
    "virtnet_xdp_xmit" -> "__virtnet_xdp_xmit_one" [color=darkgreen];
    "virtnet_xdp_xmit" -> "virtqueue_kick_prepare" [color=red, penwidth=2];
    "virtnet_xdp_xmit" -> "virtqueue_notify" [color=red, penwidth=2];
    "virtnet_xsk_pool_disable" -> "virtnet_rq_bind_xsk_pool";
    "virtnet_xsk_pool_enable" -> "virtnet_rq_bind_xsk_pool";
    "virtnet_xsk_pool_setup" -> "virtnet_xsk_pool_disable";
    "virtnet_xsk_pool_setup" -> "virtnet_xsk_pool_enable";
    "virtqueue_add" -> "virtqueue_add_split";
    "virtqueue_add_inbuf" -> "virtqueue_add";
    "virtqueue_add_inbuf_premapped" -> "virtqueue_add";
    "virtqueue_add_outbuf" -> "virtqueue_add";
    "virtqueue_add_outbuf_premapped" -> "virtqueue_add";
    "virtqueue_add_sgs" -> "virtqueue_add";
    "virtqueue_add_split" -> "virtqueue_kick" [color=red, penwidth=2];
    "virtqueue_add_split" -> "vm_notify_with_data" [color=red, penwidth=2];
    "virtqueue_kick" -> "virtqueue_kick_prepare" [color=red, penwidth=2];
    "virtqueue_kick" -> "virtqueue_notify" [color=red, penwidth=2];
    "virtqueue_notify" -> "vm_notify" [color=red, penwidth=2];
    "vm_find_vqs" -> "vm_del_vqs" [color=red, penwidth=2];
    "xmit_skb" -> "virtnet_add_outbuf";
}
