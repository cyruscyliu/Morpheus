diff --git a/include/hw/virtio/morpheus-seed.h b/include/hw/virtio/morpheus-seed.h
new file mode 100644
index 0000000000..af340a8c9e
--- /dev/null
+++ b/include/hw/virtio/morpheus-seed.h
@@ -0,0 +1,53 @@
+/*
+ * Seed-controlled hooks shared by the virtio transport and device adapters.
+ *
+ * The hooks keep the normal QEMU virtio transport and DMA implementation in
+ * the execution path.  They only provide values and completion metadata from
+ * the current LibAFL input.
+ */
+
+#ifndef HW_VIRTIO_MORPHEUS_SEED_H
+#define HW_VIRTIO_MORPHEUS_SEED_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "hw/virtio/virtio.h"
+
+typedef struct MorpheusVirtioSeedRx {
+    uint16_t queue;
+    uint32_t payload_len;
+    uint32_t used_len;
+} MorpheusVirtioSeedRx;
+
+uint64_t morpheus_virtio_seed_read_mmio(VirtIODevice *vdev,
+                                        uint64_t offset,
+                                        uint64_t value,
+                                        unsigned size,
+                                        bool keep_nonzero);
+
+uint64_t morpheus_virtio_seed_preserve_read(VirtIODevice *vdev,
+                                            uint64_t offset,
+                                            uint64_t value,
+                                            unsigned size);
+
+uint64_t morpheus_virtio_seed_read_features(VirtIODevice *vdev,
+                                            uint64_t value,
+                                            unsigned select);
+
+uint64_t morpheus_virtio_seed_read_config(VirtIODevice *vdev,
+                                          uint64_t offset,
+                                          uint64_t value,
+                                          unsigned size);
+
+bool morpheus_virtio_seed_dma_write(VirtIODevice *vdev,
+                                    uint64_t offset,
+                                    uint64_t value,
+                                    unsigned size);
+
+bool morpheus_virtio_seed_take_rx(VirtIODevice *vdev,
+                                  uint16_t queue,
+                                  MorpheusVirtioSeedRx *rx);
+
+#endif
