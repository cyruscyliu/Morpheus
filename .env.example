# Morpheus data root.
MORPHEUS_DATA_ROOT=/home/debian/Morpheus-data
MORPHEUS_WORKSPACES_ROOT=/home/debian/Morpheus-data/workspaces

DEEPSEEK_API_KEY=your_deepseek_api_key_here
# MORPHEUS_REPO_ROOT defaults to the checkout root.
# Optional overrides for tools/outline-to-paper:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_TIMEOUT_MS=5000
