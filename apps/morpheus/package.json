{
  "name": "@morpheus/app",
  "version": "0.4.3",
  "description": "Morpheus management CLI for workspace metadata, tools, and runs",
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "morpheus": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "lint": "pnpm exec tsc -p tsconfig.json --noEmit",
    "morpheus": "node dist/cli.js",
    "test:repo-structure": "pnpm run build && node --test test/repo-structure.test.js",
    "test:ci-config": "pnpm run build && node --test test/root-config.test.js",
    "test": "pnpm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.3"
  }
}
