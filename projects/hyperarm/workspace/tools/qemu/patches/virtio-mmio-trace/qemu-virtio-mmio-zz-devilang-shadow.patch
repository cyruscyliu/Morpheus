diff --git a/hw/virtio/virtio-net-mmio-devilang-shadow.c b/hw/virtio/virtio-net-mmio-devilang-shadow.c
new file mode 100644
--- /dev/null
+++ b/hw/virtio/virtio-net-mmio-devilang-shadow.c
@@ -0,0 +1,196 @@
+#include "qemu/osdep.h"
+
+#include "hw/virtio/virtio-net-mmio-devilang-shadow.h"
+#include "qemu/error-report.h"
+
+static struct virtio_net_mmio_machine hyperarm_virtio_net_mmio_shadow_machine;
+static bool hyperarm_virtio_net_mmio_shadow_initialized;
+
+static void hyperarm_virtio_net_mmio_shadow_ensure_init(void)
+{
+    if (!hyperarm_virtio_net_mmio_shadow_initialized) {
+        virtio_net_mmio_init(&hyperarm_virtio_net_mmio_shadow_machine);
+        hyperarm_virtio_net_mmio_shadow_initialized = true;
+    }
+}
+
+static void hyperarm_virtio_net_mmio_shadow_log_reject(
+    const char *line,
+    int rc,
+    size_t before_active_count,
+    size_t before_matched_count,
+    int before_booting_complete,
+    int before_runtime_started,
+    const struct devilang_active_state *before_best)
+{
+    const char *phase = "-";
+    const char *trace = "-";
+    const char *block = "-";
+    uint32_t score = 0;
+    const char *event = line ? line : "-";
+
+    if (before_best) {
+        phase = before_best->phase ? before_best->phase : "-";
+        trace = before_best->trace ? before_best->trace : "-";
+        block = before_best->block ? before_best->block : "-";
+        score = before_best->score;
+    }
+
+    if (rc < 0) {
+        error_report(
+            "hyperarm/devilang-shadow: feed failed rc=%d "
+            "before(active=%zu matched=%zu booting_complete=%d "
+            "runtime_started=%d best=%s/%s/%s score=%u) "
+            "after(active=%zu matched=%zu booting_complete=%d "
+            "runtime_started=%d) event=%s",
+            rc,
+            before_active_count,
+            before_matched_count,
+            before_booting_complete,
+            before_runtime_started,
+            phase,
+            trace,
+            block,
+            score,
+            hyperarm_virtio_net_mmio_shadow_machine.active_count,
+            hyperarm_virtio_net_mmio_shadow_machine.matched_count,
+            hyperarm_virtio_net_mmio_shadow_machine.booting_complete,
+            hyperarm_virtio_net_mmio_shadow_machine.runtime_started,
+            event);
+        return;
+    }
+
+    warn_report(
+        "hyperarm/devilang-shadow: event rejected rc=%d "
+        "before(active=%zu matched=%zu booting_complete=%d "
+        "runtime_started=%d best=%s/%s/%s score=%u) "
+        "after(active=%zu matched=%zu booting_complete=%d "
+        "runtime_started=%d) event=%s",
+        rc,
+        before_active_count,
+        before_matched_count,
+        before_booting_complete,
+        before_runtime_started,
+        phase,
+        trace,
+        block,
+        score,
+        hyperarm_virtio_net_mmio_shadow_machine.active_count,
+        hyperarm_virtio_net_mmio_shadow_machine.matched_count,
+        hyperarm_virtio_net_mmio_shadow_machine.booting_complete,
+        hyperarm_virtio_net_mmio_shadow_machine.runtime_started,
+        event);
+}
+
+static void hyperarm_virtio_net_mmio_shadow_feed(const char *line)
+{
+    struct devilang_active_state before_best;
+    struct devilang_active_state *before_best_ptr = NULL;
+    size_t before_active_count;
+    size_t before_matched_count;
+    int before_booting_complete;
+    int before_runtime_started;
+    int rc;
+
+    hyperarm_virtio_net_mmio_shadow_ensure_init();
+    if (line) {
+        before_active_count =
+            hyperarm_virtio_net_mmio_shadow_machine.active_count;
+        before_matched_count =
+            hyperarm_virtio_net_mmio_shadow_machine.matched_count;
+        before_booting_complete =
+            hyperarm_virtio_net_mmio_shadow_machine.booting_complete;
+        before_runtime_started =
+            hyperarm_virtio_net_mmio_shadow_machine.runtime_started;
+        if (virtio_net_mmio_best_active(
+                &hyperarm_virtio_net_mmio_shadow_machine,
+                &before_best) == 0) {
+            before_best_ptr = &before_best;
+        }
+        rc = virtio_net_mmio_feed_trace_line(
+            &hyperarm_virtio_net_mmio_shadow_machine, line);
+        if (rc != 0) {
+            hyperarm_virtio_net_mmio_shadow_log_reject(
+                line,
+                rc,
+                before_active_count,
+                before_matched_count,
+                before_booting_complete,
+                before_runtime_started,
+                before_best_ptr);
+        }
+    }
+}
+
+void hyperarm_virtio_net_mmio_shadow_mmio_read(uint64_t base, uint64_t offset,
+                                               uint64_t addr, uint64_t value)
+{
+    g_autofree char *line = g_strdup_printf(
+        "virtio_mmio_read base 0x%llx offset 0x%llx addr 0x%llx value 0x%llx",
+        (unsigned long long)base,
+        (unsigned long long)offset,
+        (unsigned long long)addr,
+        (unsigned long long)value);
+    hyperarm_virtio_net_mmio_shadow_feed(line);
+}
+
+void hyperarm_virtio_net_mmio_shadow_mmio_write(uint64_t base, uint64_t offset,
+                                                uint64_t addr, uint64_t value,
+                                                uint64_t dma_addr,
+                                                uint32_t dma_len,
+                                                uint32_t dma_dir,
+                                                uint32_t dma_op,
+                                                uint32_t dma_path,
+                                                const char *dma_data)
+{
+    const char *payload = (dma_data && dma_data[0]) ? dma_data : "-";
+    g_autofree char *line = g_strdup_printf(
+        "virtio_mmio_write base 0x%llx offset 0x%llx addr 0x%llx value 0x%llx "
+        "dma_addr 0x%llx dma_len 0x%x dma_dir 0x%x dma_op 0x%x dma_path 0x%x "
+        "dma_data %s",
+        (unsigned long long)base,
+        (unsigned long long)offset,
+        (unsigned long long)addr,
+        (unsigned long long)value,
+        (unsigned long long)dma_addr,
+        dma_len,
+        dma_dir,
+        dma_op,
+        dma_path,
+        payload);
+    hyperarm_virtio_net_mmio_shadow_feed(line);
+}
+
+void hyperarm_virtio_net_mmio_shadow_vring_map(void *vq, uint16_t queue,
+                                               uint64_t addr, uint32_t len,
+                                               uint32_t dir,
+                                               const char *data)
+{
+    const char *payload = (data && data[0]) ? data : "-";
+    g_autofree char *line = g_strdup_printf(
+        "virtio_vring_map vq %p queue %u addr 0x%llx len 0x%x dir %u data %s",
+        vq,
+        queue,
+        (unsigned long long)addr,
+        len,
+        dir,
+        payload);
+    hyperarm_virtio_net_mmio_shadow_feed(line);
+}
+
+void hyperarm_virtio_net_mmio_shadow_vring_unmap(void *vq, uint16_t queue,
+                                                 uint64_t addr, uint32_t len,
+                                                 uint32_t dir,
+                                                 const char *data)
+{
+    const char *payload = (data && data[0]) ? data : "-";
+    g_autofree char *line = g_strdup_printf(
+        "virtio_vring_unmap vq %p queue %u addr 0x%llx len 0x%x dir %u data %s",
+        vq,
+        queue,
+        (unsigned long long)addr,
+        len,
+        dir,
+        payload);
+    hyperarm_virtio_net_mmio_shadow_feed(line);
+}
