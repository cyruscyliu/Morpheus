 #include "trace.h"
 #include "qapi/error.h"
 
+#define MORPHEUS_QEMU_INPUT_PATH_ENV "MORPHEUS_QEMU_INPUT_PATH"
+#define MORPHEUS_QEMU_INPUT_MAX_BYTES (1U << 20)
+#define MORPHEUS_QEMU_DMA_MAX_LEN (1U << 20)
+#define MORPHEUS_HP_DMA_EVENT_OFFSET 0x0c0u
+#define MORPHEUS_HP_DMA_ADDR_LO_OFFSET 0x0c4u
+#define MORPHEUS_HP_DMA_ADDR_HI_OFFSET 0x0c8u
+#define MORPHEUS_HP_DMA_LENGTH_OFFSET 0x0ccu
+#define MORPHEUS_HP_DMA_EVENT_OPCODE_MASK 0x000000ffu
+#define MORPHEUS_HP_DMA_EVENT_DIRECTION_SHIFT 8u
+#define MORPHEUS_HP_DMA_EVENT_DIRECTION_MASK 0x00000300u
+#define MORPHEUS_HP_DMA_EVENT_OP_MAP 0x04u
+#define MORPHEUS_HP_DMA_EVENT_DIR_FROM_DEVICE 0x2u
+#define MORPHEUS_HP_DMA_EVENT_DIR_BIDIRECTIONAL 0x3u
+
+typedef struct MorpheusVirtIOMMIOFuzzState {
+    bool initialized;
+    bool enabled;
+    uint8_t *data;
+    gsize len;
+    uint64_t cursor;
+    uint32_t dma_addr_lo;
+    uint32_t dma_addr_hi;
+    uint32_t dma_len;
+} MorpheusVirtIOMMIOFuzzState;
+
+static MorpheusVirtIOMMIOFuzzState morpheus_virtio_mmio_fuzz;
+
+static void morpheus_virtio_mmio_fuzz_init(void)
+{
+    const char *path;
+    gchar *data = NULL;
+    gsize len = 0;
+
+    if (morpheus_virtio_mmio_fuzz.initialized) {
+        return;
+    }
+
+    morpheus_virtio_mmio_fuzz.initialized = true;
+    path = g_getenv(MORPHEUS_QEMU_INPUT_PATH_ENV);
+    if (!path || !*path ||
+        !g_file_get_contents(path, &data, &len, NULL) ||
+        len == 0 || len > MORPHEUS_QEMU_INPUT_MAX_BYTES) {
+        g_free(data);
+        return;
+    }
+
+    morpheus_virtio_mmio_fuzz.data = (uint8_t *)data;
+    morpheus_virtio_mmio_fuzz.len = len;
+    morpheus_virtio_mmio_fuzz.enabled = true;
+}
+
+static bool morpheus_virtio_mmio_should_fuzz(VirtIODevice *vdev)
+{
+    morpheus_virtio_mmio_fuzz_init();
+
+    return morpheus_virtio_mmio_fuzz.enabled && vdev &&
+           vdev->device_id == VIRTIO_ID_NET;
+}
+
+static uint64_t morpheus_virtio_mmio_next(unsigned size)
+{
+    uint64_t value = 0;
+    unsigned i;
+
+    for (i = 0; i < size; i++) {
+        value |= (uint64_t)morpheus_virtio_mmio_fuzz
+                 .data[morpheus_virtio_mmio_fuzz.cursor %
+                       morpheus_virtio_mmio_fuzz.len] << (i * 8);
+        morpheus_virtio_mmio_fuzz.cursor++;
+    }
+
+    return value;
+}
+
+static void morpheus_virtio_mmio_next_buf(uint8_t *buf, size_t len)
+{
+    size_t i;
+
+    for (i = 0; i < len; i++) {
+        buf[i] = morpheus_virtio_mmio_fuzz
+                 .data[morpheus_virtio_mmio_fuzz.cursor %
+                       morpheus_virtio_mmio_fuzz.len];
+        morpheus_virtio_mmio_fuzz.cursor++;
+    }
+}
+
+static uint64_t morpheus_virtio_mmio_fuzz_mix(hwaddr offset, uint64_t base,
+                                              unsigned size, bool keep_nonzero)
+{
+    uint64_t mask;
+    uint64_t fuzzed;
+
+    if (size >= sizeof(uint64_t)) {
+        mask = UINT64_MAX;
+    } else {
+        mask = (UINT64_C(1) << (size * 8)) - 1;
+    }
+    fuzzed = (base ^ morpheus_virtio_mmio_next(size)) & mask;
+    if (keep_nonzero && base != 0 && fuzzed == 0) {
+        fuzzed = base & mask;
+    }
+    trace_virtio_mmio_fuzz_read(offset, base, fuzzed, size,
+                                morpheus_virtio_mmio_fuzz.cursor);
+    return fuzzed;
+}
+
+static uint8_t morpheus_virtio_mmio_dma_opcode(uint32_t event)
+{
+    return event & MORPHEUS_HP_DMA_EVENT_OPCODE_MASK;
+}
+
+static uint8_t morpheus_virtio_mmio_dma_direction(uint32_t event)
+{
+    return (event & MORPHEUS_HP_DMA_EVENT_DIRECTION_MASK) >>
+           MORPHEUS_HP_DMA_EVENT_DIRECTION_SHIFT;
+}
+
+static bool morpheus_virtio_mmio_dma_writeable(uint8_t direction)
+{
+    return direction == MORPHEUS_HP_DMA_EVENT_DIR_FROM_DEVICE ||
+           direction == MORPHEUS_HP_DMA_EVENT_DIR_BIDIRECTIONAL;
+}
+
+static bool morpheus_virtio_mmio_fuzz_dma_write(VirtIODevice *vdev,
+                                                hwaddr offset, uint64_t value,
+                                                unsigned size)
+{
+    uint32_t event;
+    uint8_t opcode;
+    uint8_t direction;
+    uint64_t addr;
+    uint32_t len;
+    uint8_t *buf;
+    MemTxResult status;
+
+    if (size != sizeof(uint32_t)) {
+        return false;
+    }
+    if (offset == MORPHEUS_HP_DMA_ADDR_LO_OFFSET) {
+        morpheus_virtio_mmio_fuzz.dma_addr_lo = (uint32_t)value;
+        return true;
+    }
+    if (offset == MORPHEUS_HP_DMA_ADDR_HI_OFFSET) {
+        morpheus_virtio_mmio_fuzz.dma_addr_hi = (uint32_t)value;
+        return true;
+    }
+    if (offset == MORPHEUS_HP_DMA_LENGTH_OFFSET) {
+        morpheus_virtio_mmio_fuzz.dma_len = (uint32_t)value;
+        return true;
+    }
+    if (offset != MORPHEUS_HP_DMA_EVENT_OFFSET) {
+        return false;
+    }
+
+    event = (uint32_t)value;
+    opcode = morpheus_virtio_mmio_dma_opcode(event);
+    direction = morpheus_virtio_mmio_dma_direction(event);
+    addr = ((uint64_t)morpheus_virtio_mmio_fuzz.dma_addr_hi << 32) |
+           morpheus_virtio_mmio_fuzz.dma_addr_lo;
+    len = morpheus_virtio_mmio_fuzz.dma_len;
+
+    if (opcode != MORPHEUS_HP_DMA_EVENT_OP_MAP ||
+        !morpheus_virtio_mmio_dma_writeable(direction) ||
+        addr == 0 || len == 0 || len > MORPHEUS_QEMU_DMA_MAX_LEN ||
+        addr > UINT64_MAX - ((uint64_t)len - 1) || !vdev->dma_as) {
+        trace_virtio_mmio_dma_fuzz(addr, len, event, opcode, direction,
+                                   morpheus_virtio_mmio_fuzz.cursor, -1);
+        return true;
+    }
+
+    buf = g_try_malloc(len);
+    if (!buf) {
+        trace_virtio_mmio_dma_fuzz(addr, len, event, opcode, direction,
+                                   morpheus_virtio_mmio_fuzz.cursor, -2);
+        return true;
+    }
+    morpheus_virtio_mmio_next_buf(buf, len);
+    status = address_space_write(vdev->dma_as, addr,
+                                 MEMTXATTRS_UNSPECIFIED, buf, len);
+    g_free(buf);
+    trace_virtio_mmio_dma_fuzz(addr, len, event, opcode, direction,
+                               morpheus_virtio_mmio_fuzz.cursor,
+                               (int)status);
+    return true;
+}
+
+static uint64_t morpheus_virtio_mmio_maybe_fuzz_read(VirtIODevice *vdev,
+                                                     hwaddr offset,
+                                                     uint64_t value,
+                                                     unsigned size,
+                                                     bool keep_nonzero)
+{
+    if (!morpheus_virtio_mmio_should_fuzz(vdev)) {
+        return value;
+    }
+    return morpheus_virtio_mmio_fuzz_mix(offset, value, size, keep_nonzero);
+}
+
