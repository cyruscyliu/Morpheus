digraph VirtnetSinkSubgraph {
    rankdir=LR;
    node [shape=box, style=filled, fillcolor=lightyellow];

    subgraph cluster_virtnet_roots {
        label="virtnet_netdev roots";
        style="rounded,filled";
        fillcolor="#eeffee";
        color=darkgreen;
        fontcolor=darkgreen;
        penwidth=2;
        "start_xmit";
        "virtnet_close";
        "virtnet_open";
        "virtnet_set_features";
        "virtnet_set_mac_address";
        "virtnet_set_rx_mode";
        "virtnet_tx_timeout";
        "virtnet_vlan_rx_add_vid";
        "virtnet_vlan_rx_kill_vid";
        "virtnet_xdp";
        "virtnet_xdp_xmit";
        "virtnet_xsk_wakeup";
    }

    subgraph cluster_mmio_sinks {
        label="virtio_mmio_config_ops";
        style="rounded,filled";
        fillcolor="#ffeaea";
        color=darkred;
        fontcolor=darkred;
        penwidth=2;
        "vm_bus_name";
        "vm_del_vqs";
        "vm_finalize_features";
        "vm_find_vqs";
        "vm_generation";
        "vm_get";
        "vm_get_features";
        "vm_get_shm_region";
        "vm_get_status";
        "vm_notify";
        "vm_notify_with_data";
        "vm_reset";
        "vm_set";
        "vm_set_status";
        "vm_synchronize_cbs";
    }

    subgraph cluster_io_sinks {
        label="IO sinks";
        style="rounded,filled";
        fillcolor="#fff2cc";
        color=darkorange;
        fontcolor=darkorange;
        penwidth=2;
        "ioread32";
        "readb";
        "readl";
        "readw";
        "writeb";
        "writel";
        "writew";
    }

    subgraph cluster_dma_sinks {
        label="DMA and queue sinks";
        style="rounded,filled";
        fillcolor="#ddeeff";
        color=steelblue;
        fontcolor=steelblue;
        penwidth=2;
        "vring_alloc_queue";
        "vring_map_one_sg";
        "vring_map_single";
    }

    "__virtnet_rx_resume";
    "__virtnet_xdp_xmit_one";
    "add_recvbuf_big";
    "add_recvbuf_mergeable";
    "add_recvbuf_small";
    "sg_init_one";
    "sg_init_table";
    "sg_set_buf";
    "sg_set_page";
    "try_fill_recv";
    "virtio_cwrite8";
    "virtnet_add_outbuf";
    "virtnet_clear_guest_offloads";
    "virtnet_commit_rss_command";
    "virtnet_restore_guest_offloads";
    "virtnet_rq_bind_xsk_pool";
    "virtnet_rq_init_one_sg";
    "virtnet_rx_resume";
    "virtnet_rx_resume_all";
    "virtnet_send_command";
    "virtnet_send_command_reply";
    "virtnet_set_guest_offloads";
    "virtnet_set_queues";
    "virtnet_xdp_set";
    "virtnet_xsk_pool_disable";
    "virtnet_xsk_pool_enable";
    "virtnet_xsk_pool_setup";
    "virtqueue_add";
    "virtqueue_add_inbuf";
    "virtqueue_add_inbuf_premapped";
    "virtqueue_add_indirect_packed";
    "virtqueue_add_outbuf";
    "virtqueue_add_outbuf_premapped";
    "virtqueue_add_packed";
    "virtqueue_add_sgs";
    "virtqueue_add_split";
    "virtqueue_kick";
    "virtqueue_kick_prepare";
    "virtqueue_notify";
    "xmit_skb";

    "__virtnet_rx_resume" -> "try_fill_recv";
    "__virtnet_xdp_xmit_one" -> "sg_init_table";
    "__virtnet_xdp_xmit_one" -> "sg_set_buf";
    "__virtnet_xdp_xmit_one" -> "sg_set_page";
    "__virtnet_xdp_xmit_one" -> "virtnet_add_outbuf";
    "add_recvbuf_big" -> "sg_init_table";
    "add_recvbuf_big" -> "sg_set_buf";
    "add_recvbuf_big" -> "virtqueue_add_inbuf";
    "add_recvbuf_mergeable" -> "virtnet_rq_init_one_sg";
    "add_recvbuf_mergeable" -> "virtqueue_add_inbuf_premapped";
    "add_recvbuf_small" -> "virtnet_rq_init_one_sg";
    "add_recvbuf_small" -> "virtqueue_add_inbuf_premapped";
    "ioread32" -> "readl" [color=darkorange, penwidth=2];
    "sg_set_buf" -> "sg_set_page";
    "start_xmit" -> "virtqueue_kick_prepare" [color=darkgreen];
    "start_xmit" -> "virtqueue_notify" [color=darkgreen];
    "start_xmit" -> "xmit_skb" [color=darkgreen];
    "try_fill_recv" -> "add_recvbuf_big";
    "try_fill_recv" -> "add_recvbuf_mergeable";
    "try_fill_recv" -> "add_recvbuf_small";
    "try_fill_recv" -> "virtqueue_kick_prepare";
    "try_fill_recv" -> "virtqueue_notify";
    "virtio_cwrite8" -> "vm_set" [color=darkred, penwidth=2];
    "virtnet_add_outbuf" -> "virtqueue_add_outbuf";
    "virtnet_clear_guest_offloads" -> "virtnet_set_guest_offloads";
    "virtnet_commit_rss_command" -> "sg_init_table";
    "virtnet_commit_rss_command" -> "sg_set_buf";
    "virtnet_commit_rss_command" -> "virtnet_send_command";
    "virtnet_open" -> "try_fill_recv" [color=darkgreen];
    "virtnet_restore_guest_offloads" -> "virtnet_set_guest_offloads";
    "virtnet_rq_bind_xsk_pool" -> "virtnet_rx_resume";
    "virtnet_rq_init_one_sg" -> "sg_init_table";
    "virtnet_rx_resume" -> "__virtnet_rx_resume";
    "virtnet_rx_resume_all" -> "__virtnet_rx_resume";
    "virtnet_send_command" -> "virtnet_send_command_reply";
    "virtnet_send_command_reply" -> "sg_init_one";
    "virtnet_send_command_reply" -> "virtqueue_add_sgs";
    "virtnet_send_command_reply" -> "virtqueue_kick";
    "virtnet_set_features" -> "virtnet_commit_rss_command" [color=darkgreen];
    "virtnet_set_features" -> "virtnet_set_guest_offloads" [color=darkgreen];
    "virtnet_set_guest_offloads" -> "sg_init_one";
    "virtnet_set_guest_offloads" -> "virtnet_send_command";
    "virtnet_set_mac_address" -> "sg_init_one" [color=darkgreen];
    "virtnet_set_mac_address" -> "virtio_cwrite8" [color=darkgreen];
    "virtnet_set_mac_address" -> "virtnet_send_command" [color=darkgreen];
    "virtnet_set_queues" -> "sg_init_one";
    "virtnet_set_queues" -> "virtnet_commit_rss_command";
    "virtnet_set_queues" -> "virtnet_send_command";
    "virtnet_vlan_rx_add_vid" -> "sg_init_one" [color=darkgreen];
    "virtnet_vlan_rx_add_vid" -> "virtnet_send_command" [color=darkgreen];
    "virtnet_vlan_rx_kill_vid" -> "sg_init_one" [color=darkgreen];
    "virtnet_vlan_rx_kill_vid" -> "virtnet_send_command" [color=darkgreen];
    "virtnet_xdp" -> "virtnet_xdp_set" [color=darkgreen];
    "virtnet_xdp" -> "virtnet_xsk_pool_setup" [color=darkgreen];
    "virtnet_xdp_set" -> "virtnet_clear_guest_offloads";
    "virtnet_xdp_set" -> "virtnet_restore_guest_offloads";
    "virtnet_xdp_set" -> "virtnet_rx_resume_all";
    "virtnet_xdp_set" -> "virtnet_set_queues";
    "virtnet_xdp_xmit" -> "__virtnet_xdp_xmit_one" [color=darkgreen];
    "virtnet_xdp_xmit" -> "virtqueue_kick_prepare" [color=darkgreen];
    "virtnet_xdp_xmit" -> "virtqueue_notify" [color=darkgreen];
    "virtnet_xsk_pool_disable" -> "virtnet_rq_bind_xsk_pool";
    "virtnet_xsk_pool_enable" -> "virtnet_rq_bind_xsk_pool";
    "virtnet_xsk_pool_setup" -> "virtnet_xsk_pool_disable";
    "virtnet_xsk_pool_setup" -> "virtnet_xsk_pool_enable";
    "virtqueue_add" -> "virtqueue_add_packed";
    "virtqueue_add" -> "virtqueue_add_split";
    "virtqueue_add_inbuf" -> "virtqueue_add";
    "virtqueue_add_inbuf_premapped" -> "virtqueue_add";
    "virtqueue_add_indirect_packed" -> "vring_map_one_sg" [color=steelblue, penwidth=2];
    "virtqueue_add_indirect_packed" -> "vring_map_single" [color=steelblue, penwidth=2];
    "virtqueue_add_outbuf" -> "virtqueue_add";
    "virtqueue_add_outbuf_premapped" -> "virtqueue_add";
    "virtqueue_add_packed" -> "virtqueue_add_indirect_packed";
    "virtqueue_add_packed" -> "vring_map_one_sg" [color=steelblue, penwidth=2];
    "virtqueue_add_sgs" -> "virtqueue_add";
    "virtqueue_add_split" -> "virtqueue_kick";
    "virtqueue_add_split" -> "vm_notify_with_data" [color=darkred, penwidth=2];
    "virtqueue_add_split" -> "vring_map_one_sg" [color=steelblue, penwidth=2];
    "virtqueue_add_split" -> "vring_map_single" [color=steelblue, penwidth=2];
    "virtqueue_kick" -> "virtqueue_kick_prepare";
    "virtqueue_kick" -> "virtqueue_notify";
    "virtqueue_notify" -> "vm_notify" [color=darkred, penwidth=2];
    "vm_finalize_features" -> "writel" [color=darkorange, penwidth=2];
    "vm_find_vqs" -> "vm_del_vqs" [color=darkred, penwidth=2];
    "vm_generation" -> "readl" [color=darkorange, penwidth=2];
    "vm_get" -> "ioread32" [color=darkorange, penwidth=2];
    "vm_get" -> "readb" [color=darkorange, penwidth=2];
    "vm_get" -> "readl" [color=darkorange, penwidth=2];
    "vm_get" -> "readw" [color=darkorange, penwidth=2];
    "vm_get_features" -> "readl" [color=darkorange, penwidth=2];
    "vm_get_features" -> "writel" [color=darkorange, penwidth=2];
    "vm_get_shm_region" -> "readl" [color=darkorange, penwidth=2];
    "vm_get_shm_region" -> "writel" [color=darkorange, penwidth=2];
    "vm_get_status" -> "readl" [color=darkorange, penwidth=2];
    "vm_notify" -> "writel" [color=darkorange, penwidth=2];
    "vm_notify_with_data" -> "writel" [color=darkorange, penwidth=2];
    "vm_reset" -> "writel" [color=darkorange, penwidth=2];
    "vm_set" -> "writeb" [color=darkorange, penwidth=2];
    "vm_set" -> "writel" [color=darkorange, penwidth=2];
    "vm_set" -> "writew" [color=darkorange, penwidth=2];
    "vm_set_status" -> "writel" [color=darkorange, penwidth=2];
    "xmit_skb" -> "sg_init_table";
    "xmit_skb" -> "sg_set_buf";
    "xmit_skb" -> "virtnet_add_outbuf";
}
