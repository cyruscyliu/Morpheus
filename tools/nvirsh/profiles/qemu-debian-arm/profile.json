{
  "name": "qemu-debian-arm64",
  "description": "Debian arm64 nested virtualization profile using Buildroot outputs.",
  "l0": {
    "image": "https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-arm64.qcow2",
    "workspace": "workspace",
    "provisionScript": "l0-provision.sh",
    "sshPublicKey": ""
  },
  "l1": {
    "launcher": "qemu-system-aarch64",
    "launcherArgs": [
      "-machine",
      "virt,virtualization=on",
      "-cpu",
      "cortex-a57",
      "-m",
      "8192",
      "-smp",
      "4",
      "-netdev",
      "user,id=u1,hostfwd=tcp::2222-:22"
    ],
    "provisionScript": "l1-provision.sh",
    "replaceKernel": true,
    "ccaHostStack": {
      "archiveUrl": "https://github.com/p-b-o/qemu-linux-stack/releases/download/build/master-11247fd.tar.xz",
      "archiveSha256": "0d9cc57c109bcdc42294a41334e2909fa51c42784160fb5a7396dfce49c90d07"
    },
    "sshPort": 2222
  },
  "l2": {
    "launcher": "qemu-system-aarch64",
    "launcherArgs": [
      "-machine",
      "virt,virtualization=on",
      "-cpu",
      "cortex-a57",
      "-m",
      "1024",
      "-kernel",
      "{buildroot:images/Image}",
      "-initrd",
      "{buildroot:images/rootfs.cpio.gz}"
    ]
  }
}
