{
  "name": "devilang",
  "runtime": null,
  "cli-contract": "build,exec,compile-state,replay-trace,inspect,logs",
  "config": {
    "fields": {
      "mode": { "aliases": ["mode"] },
      "build-dir-key": {
        "aliases": ["build-dir-key", "buildDirKey"]
      },
      "build-dir": {
        "aliases": ["build-dir", "buildDir"],
        "path": true
      },
      "output": {
        "aliases": ["output"],
        "path": true
      },
      "target": {
        "aliases": ["target"],
        "path": true
      },
      "clang": {
        "aliases": ["clang"]
      },
      "llbase-contract": {
        "aliases": ["llbase-contract", "llbaseContract"],
        "path": true
      },
      "llbic-json": {
        "aliases": ["llbic-json", "llbicJson"],
        "path": true
      },
      "module": {
        "aliases": ["module"],
        "repeatable": true,
        "path": true
      },
      "module-relative": {
        "aliases": ["module-relative", "moduleRelative"],
        "repeatable": true
      },
      "filter": {
        "aliases": ["filter"],
        "path": true
      },
      "kallgraph-text": {
        "aliases": ["kallgraph-text", "kallgraphText"],
        "path": true
      },
      "booting-entry": {
        "aliases": ["booting-entry", "bootingEntry"],
        "repeatable": true
      },
      "booting-entry-list": {
        "aliases": ["booting-entry-list", "bootingEntryList"],
        "path": true
      },
      "runtime-entry": {
        "aliases": ["runtime-entry", "runtimeEntry"],
        "repeatable": true
      },
      "runtime-entry-list": {
        "aliases": ["runtime-entry-list", "runtimeEntryList"],
        "path": true
      },
      "booting-machine-name": {
        "aliases": ["booting-machine-name", "bootingMachineName"]
      },
      "runtime-machine-name": {
        "aliases": ["runtime-machine-name", "runtimeMachineName"]
      },
      "input": {
        "aliases": ["input"],
        "repeatable": true,
        "path": true
      },
      "output-c": {
        "aliases": ["output-c", "outputC"],
        "path": true
      },
      "output-h": {
        "aliases": ["output-h", "outputH"],
        "path": true
      },
      "state-c": {
        "aliases": ["state-c", "stateC"],
        "path": true
      },
      "state-h": {
        "aliases": ["state-h", "stateH"],
        "path": true
      },
      "trace-log": {
        "aliases": ["trace-log", "traceLog"],
        "path": true
      },
      "symbol-prefix": {
        "aliases": ["symbol-prefix", "symbolPrefix"]
      },
      "events-limit": {
        "aliases": ["events-limit", "eventsLimit"]
      },
      "base-filter": {
        "aliases": ["base-filter", "baseFilter"]
      },
      "cc": {
        "aliases": ["cc"]
      },
      "artifacts": {
        "aliases": ["artifacts"],
        "repeatable": true
      }
    }
  },
  "inputs": {
    "build": {
      "dependencies": {
        "llbase": { "flag": "llbase-contract" }
      }
    },
    "exec": {
      "dependencies": {
        "llbase": { "flag": "llbase-contract" },
        "llbic": { "flag": "llbic-json" },
        "llcg": { "flag": "filter" }
      }
    }
  },
  "managed": {
    "schemaVersion": 1,
    "modes": ["local"],
    "local": {
      "sourceTemplate": "tools/devilang/source",
      "buildDirTemplate": "tools/devilang/builds/{buildDirKey}/build",
      "outputDirTemplate": "tools/devilang/builds/{buildDirKey}/output",
      "artifacts": {
        "build-dir": {
          "pathTemplate": "tools/devilang/builds/{buildDirKey}/build"
        },
        "output-dir": {
          "pathTemplate": "tools/devilang/builds/{buildDirKey}/output"
        },
        "manifest": {
          "pathTemplate": "tools/devilang/builds/{buildDirKey}/output/devilang-manifest.json"
        },
        "log-file": {
          "pathTemplate": "tools/devilang/builds/{buildDirKey}/output/devilang.log"
        },
        "output": {
          "pathTemplate": "tools/devilang/builds/{buildDirKey}/output"
        },
        "output-c": {
          "pathTemplate": "tools/devilang/builds/{buildDirKey}/output/devilang-state.c"
        },
        "output-h": {
          "pathTemplate": "tools/devilang/builds/{buildDirKey}/output/devilang-state.h"
        }
      },
      "commands": {
        "build": {
          "requiredFlags": ["llbase-contract"],
          "scalarFlags": ["build-dir", "clang", "llbase-contract"],
          "repeatableFlags": [],
          "pathFlags": {
            "build-dir": "tools/devilang/build"
          },
          "script": {
            "path": "scripts/build.sh",
            "shell": "bash"
          },
          "result": {
            "successSummary": "built devilang native artifacts",
            "errorSummary": "devilang native build failed",
            "manifestTemplate": "{build-dir}/manifest.json",
            "artifact": {
              "path": "build-dir",
              "locationTemplate": "{build-dir}"
            },
            "details": {
              "build_dir": "{build-dir}"
            }
          }
        },
        "exec": {
          "requiredFlags": ["output", "llbase-contract"],
          "scalarFlags": [
            "output",
            "build-dir",
            "clang",
            "llbase-contract",
            "llbic-json",
            "filter",
            "kallgraph-text",
            "booting-entry-list",
            "runtime-entry-list",
            "booting-machine-name",
            "runtime-machine-name"
          ],
          "repeatableFlags": [
            "module",
            "module-relative",
            "booting-entry",
            "runtime-entry"
          ],
          "pathFlags": {
            "build-dir": "tools/devilang/build",
            "output": "tools/devilang/builds/{buildDirKey}/output"
          },
          "script": {
            "path": "scripts/exec.sh",
            "shell": "bash"
          },
          "result": {
            "successSummary": "generated devilang state artifacts",
            "errorSummary": "devilang state generation failed",
            "manifestTemplate": "{output}/manifest.json",
            "artifact": {
              "path": "manifest",
              "locationTemplate": "{output}/devilang-manifest.json"
            },
            "details": {
              "output": "{output}"
            }
          }
        },
        "compile-state": {
          "requiredFlags": ["output-c", "output-h"],
          "scalarFlags": [
            "output-c",
            "output-h",
            "symbol-prefix"
          ],
          "repeatableFlags": [
            "input"
          ],
          "script": {
            "path": "scripts/compile-state.sh",
            "shell": "bash"
          },
          "result": {
            "successSummary": "compiled devilang state into C sources",
            "errorSummary": "devilang state compilation failed",
            "artifact": {
              "path": "output-c",
              "locationTemplate": "{output-c}"
            }
          }
        },
        "replay-trace": {
          "requiredFlags": ["trace-log", "output"],
          "scalarFlags": [
            "state-c",
            "state-h",
            "trace-log",
            "output",
            "symbol-prefix",
            "events-limit",
            "base-filter",
            "cc"
          ],
          "repeatableFlags": [
            "input"
          ],
          "script": {
            "path": "scripts/replay-trace.sh",
            "shell": "bash"
          },
          "result": {
            "successSummary": "replayed devilang state machine against trace",
            "errorSummary": "devilang trace replay failed",
            "artifact": {
              "path": "output",
              "locationTemplate": "{output}"
            }
          }
        },
        "inspect": {
          "requiredFlags": ["target"],
          "scalarFlags": ["target"],
          "repeatableFlags": [],
          "script": {
            "path": "scripts/inspect.sh",
            "shell": "bash"
          },
          "result": {
            "successSummary": "inspected existing devilang manifest"
          }
        },
        "logs": {
          "requiredFlags": ["target"],
          "scalarFlags": ["target"],
          "repeatableFlags": [],
          "script": {
            "path": "scripts/logs.sh",
            "shell": "bash"
          },
          "result": {
            "successSummary": "read devilang log"
          }
        }
      }
    }
  }
}
